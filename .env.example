# Copia este archivo como `.env` (desarrollo) o `.env.production` (build) y ajusta los valores.
# Nunca subas archivos .env con valores reales al repositorio.

# URL base del backend sigat-durazno-api (todas sus rutas empiezan por /api/v1).
#   - Desarrollo con `npm run dev`: /api/v1 (Vite redirige /api al backend, sin CORS)
#   - Mismo dominio detrás de un proxy inverso: /api/v1   (recomendado en producción)
#   - Dominio aparte: https://<dominio-api>/api/v1  (el backend debe permitir CORS para el origen de la web,
#     usar HTTPS y ser del mismo sitio que la web; ver README, «Despliegue»)
#   - Nunca: //host (protocol-relative), http:// hacia otro equipo, barras invertidas.
VITE_API_URL=/api/v1

# Tiempo máximo de espera por petición (ms).
VITE_API_TIMEOUT_MS=20000

# Solo desarrollo: a dónde redirige `npm run dev` las peticiones a /api.
VITE_DEV_API_PROXY=http://localhost:8000
